# Optional configuration; this file is never loaded automatically.
# Copy to .env, then use: node --env-file=.env src/server.mjs
PORT=4318
LEARNING_DATA_DIR=.data
LEARNING_VAULT_DIR=vault
# On Linux/macOS only, set a unique random value before saving provider secrets.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep it stable and private; losing/changing it makes saved secrets unreadable.
# LEARNING_MASTER_KEY=
# MCP normally reads .data/mcp-token; do not copy a real token into this example.
# LEARNING_BASE_URL=http://127.0.0.1:4318
# LEARNING_MCP_TOKEN=
