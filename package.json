{
  "name": "learning-workbench",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "mcp": "node src/mcp.mjs",
    "mcp:chatgpt": "node src/mcp-chatgpt.mjs",
    "check": "node scripts/check-project.mjs",
    "quality": "node scripts/quality-check.mjs",
    "verify": "pnpm check && pnpm test && pnpm quality",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:sync": "node scripts/prepare-android.mjs && node node_modules/@capacitor/cli/bin/capacitor sync android",
    "android:test-device": "node scripts/test-android-device.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@modelcontextprotocol/sdk": "1.32.0",
    "filepond": "4.32.12",
    "filepond-plugin-file-validate-size": "2.2.8",
    "filepond-plugin-file-validate-type": "1.2.9",
    "filepond-plugin-image-preview": "4.6.12",
    "mammoth": "1.13.0",
    "vditor": "4.0.0",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  }
}
